rules_version = '2';

// =====================================================================
//  mi-cartera-b43e0 — UN solo ruleset para TRES apps
// =====================================================================
//
//  Firestore admite un unico ruleset por base de datos, y las tres apps
//  (Mi Cartera de Roberto, Cartera de Zoe, Cartera de la Casa) comparten
//  el mismo proyecto Firebase. El aislamiento entre ellas se logra
//  namespaceando las colecciones y dando acceso a cada correo SOLO a las
//  suyas.
//
//  Reparto de namespaces:
//    Roberto  rl7103405@gmail.com  -> cartera/*  + gastos, ingresos,
//                                     transferencias, stocksOps
//    Zoe      zoe.frei@outlook.de  -> zoe/*      + zoe_*
//    La Casa  rl7103405+casa@gmail.com      -> casa/*     + casa_*
//                                     (cuenta compartida por 3 hermanos)
//
//  NOTAS IMPORTANTES DE MANTENIMIENTO:
//
//  1. Firestore NO soporta comodines de prefijo en el nombre de la
//     coleccion: NO existe match /zoe_*/{doc}. Por eso cada coleccion va
//     enumerada a mano. Si una app empieza a usar una coleccion nueva,
//     HAY QUE AGREGARLA AQUI o esa parte de la app dejara de funcionar.
//
//  2. Las reglas se combinan con OR: basta que UNA regla permita para que
//     la operacion pase. Por eso aqui NO hay ningun catch-all permisivo
//     (el viejo `match /{document=**} { allow read, write: if ... }`
//     anulaba cualquier restriccion y quedo eliminado).
//
//  3. {documento=**} dentro de cada bloque es un comodin recursivo pero
//     ACOTADO a esa coleccion: cubre el documento y cualquier
//     subcoleccion futura sin abrir nada de las otras carteras.
//
//  4. NO se exige email_verified a proposito: la cuenta de la casa se crea
//     a mano en la consola de Firebase y nunca pasa por verificacion.
//     Exigirlo dejaria a los tres hermanos fuera de su propia app.
//     El correo es un alias (+casa) del Gmail de Roberto, o sea que el
//     dominio lo controla el; NO usar dominios ajenos aqui.
//
//  5. Las colecciones de Roberto no llevan prefijo (gastos, ingresos,
//     transferencias, stocksOps). Si algun dia se agrega una CUARTA app,
//     sus colecciones deben ir prefijadas; nunca reutilizar esos nombres
//     genericos.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    //  Identidad — un correo exacto por app.
    //  request.auth != null bloquea anonimos y no autenticados.
    //  La comparacion exacta bloquea cualquier otro correo del proyecto.
    // ---------------------------------------------------------------
    function esRoberto() {
      return request.auth != null
        && request.auth.token.email == 'rl7103405@gmail.com';
    }

    function esZoe() {
      return request.auth != null
        && request.auth.token.email == 'zoe.frei@outlook.de';
    }

    function esTono() {
      return request.auth != null
        && request.auth.token.email == 'tono32sa@gmail.com';
    }

    function esEli() {
      return request.auth != null
        && request.auth.token.email == 'elilinaresa@gmail.com';
    }

    function esCasa() {
      return request.auth != null
        && request.auth.token.email == 'rl7103405+casa@gmail.com';
    }


    // ===============================================================
    //  ROBERTO — mi-cartera
    // ===============================================================

    // Documentos de configuracion y estado:
    // saldos, mercado, personas, perfil, tarjeta, tarjetaRev,
    // historial, apartados, categorias, posiciones

    // ---------------------------------------------------------------
    //  (20-oct-2026) CUENTAS EN OTRA MONEDA (doc <ns>/cuentasX).
    //  Un gasto, ingreso o transferencia que toca una cuenta x_ solo se
    //  puede CREAR o BORRAR si esa misma operacion cambia <ns>/cuentasX
    //  (el dinero entra o regresa a su cuenta), y no se le puede cambiar
    //  monto, moneda ni cuenta. Asi una version vieja de la app, que no
    //  conoce cuentasX, no puede borrarlo sin devolver el dinero.
    //  Los movimientos de siempre (sin x_) no cambian en nada.
    // ---------------------------------------------------------------
    function esX(v) {
      return v is string && v.matches('x_[a-z0-9]{6,16}');
    }
    function tocaX(d) {
      return esX(d.get('fuente', '')) || esX(d.get('destino', '')) || esX(d.get('origen', ''));
    }
    // el saldo de UNA cuenta exacta antes/despues de la operacion: renombrar u otra cuenta no cuenta
    function saldoCX(s, id) {
      return s.data.get('cuentas', {}).get(id, {}).get('saldo', null);
    }
    function cxMueve(ns, id) {
      return saldoCX(getAfter(/databases/$(database)/documents/$(ns)/cuentasX), id)
          != saldoCX(get(/databases/$(database)/documents/$(ns)/cuentasX), id);
    }
    // cada lado x_ del movimiento (fuente, destino u origen; una transferencia x_ -> x_ tiene dos)
    // debe haber movido SU saldo. Un lado que no es x_ no se exige aqui
    function ladoMueve(ns, d, campo) {
      return !esX(d.get(campo, '')) || cxMueve(ns, d.get(campo, ''));
    }
    function movidoX(ns, d) {
      return ladoMueve(ns, d, 'fuente') && ladoMueve(ns, d, 'destino') && ladoMueve(ns, d, 'origen');
    }
    function igualX(campo) {
      return request.resource.data.get(campo, null) == resource.data.get(campo, null);
    }
    function creaX(ns) { return !tocaX(request.resource.data) || movidoX(ns, request.resource.data); }
    function borraX(ns) { return !tocaX(resource.data) || movidoX(ns, resource.data); }
    function editaX() {
      return (!tocaX(resource.data) && !tocaX(request.resource.data))
          || (igualX('monto') && igualX('montoOrig') && igualX('moneda') && igualX('tc')
              && igualX('fuente') && igualX('destino') && igualX('origen')
              && igualX('montoOrigen') && igualX('montoDestino')
              && igualX('monedaOrigen') && igualX('monedaDestino') && igualX('tcFecha')
              && igualX('pendiente') && igualX('aplicadoSaldo') && igualX('porAtajo'));
    }

    match /cartera/{documento=**} {
      allow read, write: if esRoberto();
    }

    // Colecciones de movimientos (sin prefijo, historicas)
    match /gastos/{documento=**} {
      allow read: if esRoberto();
      allow create: if esRoberto() && creaX('cartera');
      allow update: if esRoberto() && editaX();
      allow delete: if esRoberto() && borraX('cartera');
    }
    match /ingresos/{documento=**} {
      allow read: if esRoberto();
      allow create: if esRoberto() && creaX('cartera');
      allow update: if esRoberto() && editaX();
      allow delete: if esRoberto() && borraX('cartera');
    }
    match /transferencias/{documento=**} {
      allow read: if esRoberto();
      allow create: if esRoberto() && creaX('cartera');
      allow update: if esRoberto() && editaX();
      allow delete: if esRoberto() && borraX('cartera');
    }
    match /stocksOps/{documento=**} {
      allow read, write: if esRoberto();
    }
    // tramos de rendimiento de las cuentas de interes (16-sep-2026): un doc por tramo cerrado
    match /rendimientos/{documento=**} {
      allow read, write: if esRoberto();
    }


    // ===============================================================
    //  ZOE — mi-cartera-zoe   (NS = 'zoe', PFX = 'zoe_')
    // ===============================================================

    // Documentos: saldos, mercado, personas, perfil, tarjeta,
    // tarjetaRev, historial, apartados, categorias, posiciones
    match /zoe/{documento=**} {
      allow read, write: if esZoe();
    }

    match /zoe_gastos/{documento=**} {
      allow read: if esZoe();
      allow create: if esZoe() && creaX('zoe');
      allow update: if esZoe() && editaX();
      allow delete: if esZoe() && borraX('zoe');
    }
    match /zoe_ingresos/{documento=**} {
      allow read: if esZoe();
      allow create: if esZoe() && creaX('zoe');
      allow update: if esZoe() && editaX();
      allow delete: if esZoe() && borraX('zoe');
    }
    match /zoe_transferencias/{documento=**} {
      allow read: if esZoe();
      allow create: if esZoe() && creaX('zoe');
      allow update: if esZoe() && editaX();
      allow delete: if esZoe() && borraX('zoe');
    }
    match /zoe_stocksOps/{documento=**} {
      allow read, write: if esZoe();
    }
    // tramos de rendimiento de las cuentas de interes (16-sep-2026): un doc por tramo cerrado
    match /zoe_rendimientos/{documento=**} {
      allow read, write: if esZoe();
    }


    // ===============================================================
    //  LA CASA — cartera-casa   (NS = 'casa', PFX = 'casa_')
    //  Cuenta unica compartida por los 3 hermanos.
    // ===============================================================

    // Documentos que la app usa hoy: saldos, personas, perfil, metas,
    // tarjeta, historial, apartados, categorias
    match /casa/{documento=**} {
      allow read, write: if esCasa();
    }

    // Colecciones de movimientos en uso
    match /casa_gastos/{documento=**} {
      allow read: if esCasa();
      allow create: if esCasa() && creaX('casa');
      allow update: if esCasa() && editaX();
      allow delete: if esCasa() && borraX('casa');
    }
    match /casa_ingresos/{documento=**} {
      allow read: if esCasa();
      allow create: if esCasa() && creaX('casa');
      allow update: if esCasa() && editaX();
      allow delete: if esCasa() && borraX('casa');
    }
    match /casa_transferencias/{documento=**} {
      allow read: if esCasa();
      allow create: if esCasa() && creaX('casa');
      allow update: if esCasa() && editaX();
      allow delete: if esCasa() && borraX('casa');
    }
    // rastro de quien ajusto saldos a mano (escritura destructiva auditada)
    match /casa_ajustes/{documento=**} {
      allow read, write: if esCasa();
    }

    // Reservadas: la app de la casa TODAVIA no las usa (hoy las deudas
    // viven en el documento casa/personas). Se dejan abiertas por
    // adelantado para que, si se agregan, no haya que tocar reglas ni
    // redeployar. No afectan el aislamiento: solo rl7103405+casa@gmail.com entra.
    match /casa_personas/{documento=**} {
      allow read, write: if esCasa();
    }
    match /casa_deudas/{documento=**} {
      allow read, write: if esCasa();
    }
    match /casa_stocksOps/{documento=**} {
      allow read, write: if esCasa();
    }


    // ===============================================================
    //  TONO — cartera-tono   (NS = 'tono', PFX = 'tono_')
    //  Cartera personal del novio de Eli. Sus cuentas: efectivo, BBVA,
    //  American Express y GBM.
    // ===============================================================

    match /tono/{documento=**} {
      allow read, write: if esTono();
    }
    match /tono_gastos/{documento=**} {
      allow read: if esTono();
      allow create: if esTono() && creaX('tono');
      allow update: if esTono() && editaX();
      allow delete: if esTono() && borraX('tono');
    }
    match /tono_ingresos/{documento=**} {
      allow read: if esTono();
      allow create: if esTono() && creaX('tono');
      allow update: if esTono() && editaX();
      allow delete: if esTono() && borraX('tono');
    }
    match /tono_transferencias/{documento=**} {
      allow read: if esTono();
      allow create: if esTono() && creaX('tono');
      allow update: if esTono() && editaX();
      allow delete: if esTono() && borraX('tono');
    }
    match /tono_stocksOps/{documento=**} {
      allow read, write: if esTono();
    }
    // tramos de rendimiento de las cuentas de interes (16-sep-2026): un doc por tramo cerrado
    match /tono_rendimientos/{documento=**} {
      allow read, write: if esTono();
    }


    // ===============================================================
    //  ELI — cartera-eli   (NS = 'eli', PFX = 'eli_')
    //  Cartera personal de la hermana. Sus cuentas: efectivo, Nu,
    //  BBVA y GBM.
    // ===============================================================

    match /eli/{documento=**} {
      allow read, write: if esEli();
    }
    match /eli_gastos/{documento=**} {
      allow read: if esEli();
      allow create: if esEli() && creaX('eli');
      allow update: if esEli() && editaX();
      allow delete: if esEli() && borraX('eli');
    }
    match /eli_ingresos/{documento=**} {
      allow read: if esEli();
      allow create: if esEli() && creaX('eli');
      allow update: if esEli() && editaX();
      allow delete: if esEli() && borraX('eli');
    }
    match /eli_transferencias/{documento=**} {
      allow read: if esEli();
      allow create: if esEli() && creaX('eli');
      allow update: if esEli() && editaX();
      allow delete: if esEli() && borraX('eli');
    }
    match /eli_stocksOps/{documento=**} {
      allow read, write: if esEli();
    }
    // tramos de rendimiento de las cuentas de interes (16-sep-2026): un doc por tramo cerrado
    match /eli_rendimientos/{documento=**} {
      allow read, write: if esEli();
    }

    // ---------------------------------------------------------------
    //  AMIGOS (16-sep-2026): una ficha por cartera con INDICADORES del
    //  mes (calificacion, bandas de gasto/ahorro, racha), nunca montos.
    //  Lectura: solo la familia. Escritura: solo el dueno de esa ficha,
    //  solo si en SU perfil tiene encendido 'amigos' (consentimiento que
    //  el servidor verifica: una pestana vieja no puede republicar tras
    //  apagarlo), y solo con los campos de la ficha (un bug del cliente
    //  no puede publicar saldos).
    // ---------------------------------------------------------------
    function familia() { return esRoberto() || esEli() || esZoe() || esTono(); }
    function duenoFicha(id) {
      return (id == 'cartera' && esRoberto()) || (id == 'eli' && esEli())
          || (id == 'zoe' && esZoe()) || (id == 'tono' && esTono());
    }
    function consiente(id) {
      // Participar viene ENCENDIDO por defecto: solo se niega si el dueño lo apago
      // expresamente (amigos == false).
      // OJO CON EL ACCESOR: leer un campo AUSENTE de un mapa en estas reglas no devuelve
      // nulo, da ERROR, y un error DENIEGA. Y el campo casi nunca existe, porque el
      // "encendido por defecto" vive en el cliente y nadie escribe `amigos` hasta que
      // alguien lo apaga. Con `.data.amigos` directo esto denegaba TODA escritura a
      // amigos/<id> para los cuatro: ninguna ficha se publicaba ("todavia nadie participa")
      // y nadie podia salir. Roto el 16-sep, encontrado el 17-sep-2026.
      return !exists(/databases/$(database)/documents/$(id)/perfil)
          || get(/databases/$(database)/documents/$(id)/perfil).data.get('amigos', true) != false;
    }
    function fichaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['participa','nombre','inicial','mes','score','nivel','gasto','ahorro','racha','ahorroMes','ver','actualizado','puntos'])
          && (!('puntos' in d) || d.puntos == null || (d.puntos is list && d.puntos.size() <= 6))
          && d.participa is bool
          && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 24))
          && (!('inicial' in d) || d.inicial == null || (d.inicial is string && d.inicial.size() <= 4))
          && (!('mes' in d) || d.mes == null || (d.mes is string && d.mes.size() <= 7))
          && (!('nivel' in d) || d.nivel == null || (d.nivel is string && d.nivel.size() <= 24))
          && (!('ver' in d) || d.ver == null || (d.ver is string && d.ver.size() <= 8))
          && (!('actualizado' in d) || (d.actualizado is string && d.actualizado.size() <= 32))
          && (!('score' in d) || d.score == null || (d.score is number && d.score >= 0 && d.score <= 100))
          && (!('racha' in d) || d.racha == null || (d.racha is number && d.racha >= 0 && d.racha <= 24))
          && (!('gasto' in d) || d.gasto == null || (d.gasto is string && d.gasto.size() <= 16))
          && (!('ahorro' in d) || d.ahorro == null || (d.ahorro is string && d.ahorro.size() <= 16))
          && (!('ahorroMes' in d) || d.ahorroMes == null || (d.ahorroMes is string && d.ahorroMes.size() <= 16));
    }
    match /amigos/{id} {
      allow read: if familia();
      allow write: if duenoFicha(id) && consiente(id) && fichaValida();
    }


    // ===============================================================
    //  DENY-ALL FINAL
    // ===============================================================
    //  Firestore ya deniega por defecto todo lo que ninguna regla
    //  permita, asi que este bloque es redundante — se deja explicito
    //  como documentacion y como recordatorio de que aqui NO debe
    //  aparecer nunca un `if request.auth != null` catch-all.
    //  `if false` no puede otorgar nada bajo la semantica OR.
    // ===============================================================
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
